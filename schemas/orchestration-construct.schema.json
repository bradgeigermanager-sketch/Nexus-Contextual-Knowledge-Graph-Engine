{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/orchestration-construct.schema.json",
  "title": "Nexus orchestration construct",
  "description": "Framework-neutral declarative construct record with optional LangChain adapter metadata; not an execution specification by itself.",
  "type": "object",
  "required": [
    "constructId",
    "versionId",
    "family",
    "constructType",
    "label",
    "status",
    "configuration",
    "dependencies",
    "security",
    "provenance"
  ],
  "properties": {
    "constructId": {
      "type": "string",
      "minLength": 1
    },
    "versionId": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "prompt",
        "model",
        "runnable",
        "output_parser",
        "retriever",
        "store",
        "tool",
        "agent",
        "chain",
        "workflow",
        "memory",
        "callback",
        "embedding",
        "custom"
      ]
    },
    "constructType": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "validated",
        "active",
        "disabled",
        "deprecated",
        "superseded",
        "rejected"
      ]
    },
    "adapter": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "framework": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "versionConstraint": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "testedVersions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "inputContract": {
      "type": [
        "object",
        "null"
      ]
    },
    "outputContract": {
      "type": [
        "object",
        "null"
      ]
    },
    "configuration": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security": {
      "type": "object",
      "required": [
        "executionEnabled",
        "permissions",
        "secretRefs"
      ],
      "properties": {
        "executionEnabled": {
          "type": "boolean"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxIterations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "timeoutMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "humanApproval": {
          "enum": [
            "not_required",
            "required",
            "required-before-enabling",
            "per-run"
          ]
        },
        "sideEffects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "createdBy",
        "createdAt",
        "synthetic"
      ],
      "properties": {
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "synthetic": {
          "type": "boolean"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
